<!-- Counts are stored by the public Busuanzi service, not in the repository. -->
<script>
 import { visitPath } from "@/utils/visit-key";
	const fields = ["site_pv", "site_uv", "page_pv"] as const;
	let lastPath = "";
	let generation = 0;
	async function updateVisits() {
		if (location.hostname !== "rererego.github.io") return;
		const path = visitPath(location.pathname);
		if (path === lastPath) return;
		lastPath = path;
		const current = ++generation;
		const elements = () => document.querySelectorAll<HTMLElement>("[data-visit-count]");
		elements().forEach((el) => { el.textContent = "…"; el.title = "正在加载访问统计"; });
		try {
			const headers: Record<string, string> = { "x-bsz-referer": location.origin + path };
			try {
				const identity = localStorage.getItem("bsz-id");
				if (identity) headers.Authorization = `Bearer ${identity}`;
			} catch { /* Storage may be disabled. The service can still count views. */ }
			const response = await fetch("https://bsz.iirose.cn/api", {
				method: "POST", headers, signal: AbortSignal.timeout(10000),
			});
			if (!response.ok) throw new Error("Statistics unavailable");
			const result = await response.json();
			if (!result.success || !fields.every((key) => Number.isSafeInteger(result.data?.[key]) && result.data[key] >= 0)) {
				throw new Error("Invalid statistics");
			}
			try {
				const identity = response.headers.get("Set-Bsz-Identity");
				if (identity) localStorage.setItem("bsz-id", identity);
			} catch { /* Statistics must not depend on local storage access. */ }
			if (current !== generation) return;
			elements().forEach((el) => {
				const key = el.dataset.visitCount as typeof fields[number];
				el.textContent = result.data[key].toLocaleString("zh-CN");
				el.title = "由不蒜子提供访问统计；访客数为估算值";
			});
		} catch {
			if (current !== generation) return;
			elements().forEach((el) => { el.textContent = "—"; el.title = "统计暂不可用，请稍后刷新"; });
		}
	}
	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", updateVisits, { once: true });
	} else { void updateVisits(); }
	document.addEventListener("astro:page-load", updateVisits);
</script>

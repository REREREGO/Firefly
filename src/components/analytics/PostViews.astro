---
import { Icon } from "astro-icon/components";

interface Props {
	url: string;
}
const { url } = Astro.props;
---

<div class="flex items-center whitespace-nowrap" aria-label="文章浏览量">
  <div class="meta-icon">
    <Icon name="material-symbols:visibility-outline-rounded" class="text-xl" />
  </div>
  <span class="text-50 text-sm font-medium">
    <span data-post-views={url} aria-live="polite" title="正在加载文章浏览量">—</span> 次浏览
  </span>
</div>

<script>
	const seen = new WeakSet<HTMLElement>();
	async function loadPostViews() {
		if (location.hostname !== "rererego.github.io") return;
		const groups = new Map<string, HTMLElement[]>();
		for (const element of document.querySelectorAll<HTMLElement>("[data-post-views]")) {
			if (seen.has(element)) continue;
			seen.add(element);
			const target = new URL(element.dataset.postViews || "", location.origin);
			if (target.origin !== location.origin) continue;
			// Match the detail page counter: no query/hash, one trailing slash.
			const key = target.origin + target.pathname.replace(/\/+$/, "") + "/";
			const elements = groups.get(key) || [];
			elements.push(element);
			groups.set(key, elements);
		}
		const pending = [...groups.entries()];
		async function worker() {
			for (let item = pending.shift(); item; item = pending.shift()) {
				const [url, elements] = item;
				try {
					// GET only reads statistics. Never POST for cards: that records a view.
					const response = await fetch("https://bsz.iirose.cn/api", {
						method: "GET",
						headers: { "x-bsz-referer": url },
						signal: AbortSignal.timeout(10000),
					});
					if (!response.ok) throw new Error("Statistics unavailable");
					const result = await response.json();
					const count = result.data?.page_pv;
					if (!result.success || !Number.isSafeInteger(count) || count < 0) {
						throw new Error("Invalid statistics");
					}
					for (const element of elements) {
						if (!element.isConnected) continue;
						element.textContent = count.toLocaleString("zh-CN");
						element.title = "该篇文章的累计浏览量";
					}
				} catch {
					for (const element of elements) {
						if (!element.isConnected) continue;
						element.textContent = "—";
						element.title = "浏览量暂不可用，请稍后刷新";
					}
				}
			}
		}
		await Promise.all(Array.from({ length: Math.min(3, pending.length) }, worker));
	}
	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", loadPostViews, { once: true });
	} else {
		void loadPostViews();
	}
	document.addEventListener("astro:page-load", loadPostViews);
</script>
